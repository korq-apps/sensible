# Build artifacts & images
*.iso
*.iso.sha256
*.qcow2
*.ovmf-vars.fd
/build.log

# Live-build runtime & cache (per-variant artifacts are also generated)
.build/
live/.build/
live/binary/
live/chroot/
live/cache/
live/.cache/
live/auto/config.*
live/sensible-debian-testing-amd64.iso
live/sensible-gnome-debian-testing-amd64.iso
live/sensible-kde-debian-testing-amd64.iso
live/sensible-*-debian-testing-amd64.iso.sha256
live/sensible-*-debian-testing-amd64.contents
live/sensible-*-debian-testing-amd64.files
live/sensible-*-debian-testing-amd64.packages

# Regenerated by lb config / lb build on every run
live/config/binary
live/config/bootstrap
live/config/chroot
live/config/common
live/config/source
live/config/hooks/normal/
live/config/hooks/live/0010-disable-kexec-tools.hook.chroot
live/config/hooks/live/0050-disable-sysvinit-tmpfs.hook.chroot
live/chroot.files
live/chroot.packages.install
live/chroot.packages.live
live/binary.modified_timestamps

# Staged files in includes.chroot
live/config/includes.chroot/opt/sensible/
live/config/includes.chroot/usr/share/sensible/manual/
live/config/includes.chroot/usr/share/applications/sensible-manual.desktop
live/config/includes.chroot/usr/local/bin/sensible-manual
live/config/includes.chroot/etc/keyd/
# Staged by scripts/fetch-pins.sh from live/pins.env + configs/
live/config/includes.chroot/etc/skel/.bashrc
live/config/includes.chroot/etc/skel/.config/nvim/
live/config/includes.chroot/etc/gitconfig
live/config/includes.chroot/etc/sensible/
live/config/includes.chroot/usr/share/oh-my-bash/
live/config/includes.chroot/usr/local/share/fonts/
# Pinned-artifact download cache (scripts/fetch-pins.sh)
live/local/pins/
live/config/packages.chroot/localsend_amd64.deb
live/config/includes.chroot/usr/share/doc/localsend/

# Temporary files
*~
*.swp
*.bak
live/.build.lock

# Local reference clones (symlinks to sibling checkouts, machine-specific)
/omarchy
/omarchy-iso

# Agent scratch
.commandcode/

# Generated per build from live/variants/<variant>.list
live/config/package-lists/desktop.list.chroot
