# Sensible system-wide git defaults — installed to /etc/gitconfig.
# Identity (user.name / user.email) is per-user: users set their own in
# ~/.gitconfig. Anything here is overridable in ~/.gitconfig.
#
# Staged into the image by scripts/fetch-pins.sh.

[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autostash = true
