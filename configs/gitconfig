# Sensible system-wide git defaults — installed to /etc/gitconfig.
# Identity (user.name / user.email) is per-user: the installer writes the first
# user's ~/.gitconfig from the optional name/email prompts. Anything here is
# overridable in ~/.gitconfig.
#
# Status: planned (PLAN Phase 6) — not yet wired into the installer.

[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autostash = true
