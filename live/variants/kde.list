# Desktop variant: KDE Plasma (SENSIBLE_VARIANT=kde)
#
# Copied to config/package-lists/desktop.list.chroot at build time. Under the
# offline model the ISO carries the finished system, so everything the target
# needs must be here -- nothing is fetched during installation.

# Desktop
kde-plasma-desktop
sddm
plasma-discover
plasma-discover-backend-flatpak
plymouth-theme-breeze
dconf-cli

# Applications
firefox-esr
chromium
vlc
neovim
skanlite
okular
ark
gwenview
kate
kcalc
kde-spectacle
elisa
digikam
kdeconnect
plasma-systemmonitor
xdg-desktop-portal-kde

# Boot stack the installer needs on the target and cannot download
grub-efi-amd64
grub-efi-amd64-signed
shim-signed
cryptsetup-initramfs

# Hardware/session support
mesa-vulkan-drivers
va-driver-all
power-profiles-daemon
fwupd
bluez
printer-driver-all
cups
