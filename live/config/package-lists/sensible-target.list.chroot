# Sensible target closure — baked into live ISO for offline install
# This list ensures the copy-installed target has everything that
# installer/lib/*.sh previously apt-installed. No apt runs at install time.

# Kernel + microcode (hardware.sh)
linux-image-amd64
intel-microcode
amd64-microcode

# Locale / console (hardware.sh, setup)
locales
keyboard-configuration
console-setup

# Firmware is in live.list.chroot (kept there for live Wi-Fi); also needed on target
# Already in live.list: firmware-linux etc

# Graphics / media
mesa-vulkan-drivers
va-driver-all
nvidia-driver
# libspa-0.2-bluetooth is pulled by pipewire but explicit is safer
libspa-0.2-bluetooth

# Audio / networking / power / firmware updates
pipewire
wireplumber
pipewire-pulse
pipewire-audio
pipewire-alsa
network-manager
power-profiles-daemon
fwupd
bluez
wireless-regdb

# Boot / plymouth (desktop.sh)
plymouth
plymouth-themes
# kde variant adds plymouth-theme-breeze via its own list; gnome uses spinner from plymouth-themes

# Desktop common (ensured in variant lists, but keep here for safety)
# gnome-core/gdm3 or kde-plasma-desktop/sddm are in variant lists

# Apps — default set (apps.sh:install_default_apps)
firefox-esr
chromium
vlc
neovim

# Everyday productivity
libreoffice-writer
libreoffice-calc
libreoffice-impress
thunderbird
keepassxc

# Archive support used by the desktop archive managers
7zip
unzip
zip

# Terminal tools
ripgrep
fd-find
fzf
bat
eza
zoxide
btop
fastfetch
jq
sudo
curl
git
ca-certificates
flatpak
# Offline manual uses the desktop URI handler on either edition.
xdg-utils
# Pinned LocalSend is supplied through config/packages.chroot by fetch-pins.sh.
# Keep runtime dependencies explicit as well as the .deb dependency metadata.
libgtk-3-0t64
libsecret-1-0
libegl1
libgles2
libegl-mesa0
libgl1-mesa-dri
libayatana-appindicator3-1
gir1.2-ayatanaappindicator3-0.1
libayatana-ido3-0.4-0
xdg-user-dirs
xdg-desktop-portal
fonts-noto-core
fonts-noto-color-emoji
fonts-liberation
# dconf-cli needed for GNOME lock defaults
dconf-cli

# Optional but expected to be available without fetching
# (keyd, plymouth themes) — keyd is in variant? ensure target has it if GNOME
keyd

# Phase 6 extras — baked, no question asked (PLAN.md "Bake into the ISO")
# Fingerprint login: enrollment lives in GNOME/Plasma settings; dormant
# without a reader.
fprintd
libpam-fprintd

# Printing/scanning: driverless IPP-over-USB printing and eSCL/WSD scanning
# (cups + printer-driver-all are in the variant lists)
ipp-usb
sane-airscan

# Firewall: enabled by live/config/hooks/live/0300-ufw.hook.chroot
ufw
