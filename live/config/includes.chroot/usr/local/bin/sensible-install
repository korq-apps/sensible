#!/usr/bin/env bash
set -e

# The live session autologins as the unprivileged `user`, but the installer
# partitions disks and must run as root. Re-exec through sudo rather than
# failing with "must be run as root": the MOTD tells people to run
# `sensible-install`, so that exact command has to work as printed.
if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
        exec sudo -- "$0" "$@"
    fi
    echo "Error: sensible-install must run as root, and sudo is unavailable." >&2
    echo "       Log in as root and run it again." >&2
    exit 1
fi

if [ -f /opt/sensible/installer/sensible-install.sh ]; then
    exec /opt/sensible/installer/sensible-install.sh "$@"
elif [ -f /usr/local/share/sensible/installer/sensible-install.sh ]; then
    exec /usr/local/share/sensible/installer/sensible-install.sh "$@"
else
    echo "Error: Sensible installer script not found." >&2
    exit 1
fi
