#!/bin/sh
# Secure Boot for the live media: replace the unsigned standalone GRUB with
# the shim + Debian-signed GRUB chain. Shim works with Secure Boot off as
# well, so this is unconditional.
#
# NAMING MATTERS: live-build only executes hooks matching *.hook.binary (in
# config/hooks/live/ or config/hooks/normal/) at the binary stage — a file
# named just *.binary is silently skipped and the ISO ships unsigned GRUB.
# CI greps the build log for this hook's success line to catch that.
# Binary hooks run with cwd = binary/, where the EFI partition image lives at
# boot/grub/efi.img and the ISO9660 carries the same EFI tree at EFI/boot/.
set -e

SHIM=""
for candidate in /usr/lib/shim/shimx64.efi.signed /usr/lib/shim/shimx64.efi.debian; do
    if [ -f "$candidate" ]; then
        SHIM="$candidate"
        break
    fi
done
GRUB_SIGNED="/usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed"

if [ -z "$SHIM" ] || [ ! -f "$GRUB_SIGNED" ]; then
    echo "secure-boot hook: shim/grub signed binaries not found in builder image" >&2
    exit 1
fi

EFI_IMG="boot/grub/efi.img"
if [ ! -f "$EFI_IMG" ]; then
    echo "secure-boot hook: $EFI_IMG not found (wrong live-build layout?)" >&2
    exit 1
fi

# The stock efi.img is sized exactly for the standalone GRUB it ships, so it
# has no room for shim + signed GRUB. Rebuild it larger: extract everything,
# create a bigger FAT image (+8 MiB), copy back, then inject the chain.
WORK_DIR="$(mktemp -d)"
NEW_IMG="${WORK_DIR}/efi.img"

mcopy -i "$EFI_IMG" -/ -n :: "${WORK_DIR}/root"

OLD_KB=$(( ( $(stat -c%s "$EFI_IMG") + 1023) / 1024 ))
NEW_KB=$(( (OLD_KB + 8192 + 63) / 32 * 32 ))
VOLID="$(printf '%08x' $(( ${SOURCE_DATE_EPOCH:-0} % 4294967296 )))"
mkfs.msdos -C "$NEW_IMG" "$NEW_KB" -i "$VOLID" >/dev/null
mmd -i "$NEW_IMG" ::EFI ::EFI/boot ::boot ::boot/grub
mcopy -i "$NEW_IMG" -s -o "${WORK_DIR}/root/EFI" ::EFI
mcopy -i "$NEW_IMG" -s -o "${WORK_DIR}/root/boot" ::boot

mcopy -i "$NEW_IMG" -o "$SHIM" ::/EFI/boot/bootx64.efi
mcopy -i "$NEW_IMG" -o "$GRUB_SIGNED" ::/EFI/boot/grubx64.efi
mv "$NEW_IMG" "$EFI_IMG"

# Same files on the ISO9660 filesystem (UEFI removable-media fallback path).
if [ -d EFI/boot ]; then
    cp -f "$SHIM" EFI/boot/bootx64.efi
    cp -f "$GRUB_SIGNED" EFI/boot/grubx64.efi
fi

# Fail the build if the injected chain is not actually signed.
sbverify --list "$SHIM" 2>/dev/null | grep -q "Microsoft Corporation"
sbverify --list "$GRUB_SIGNED" 2>/dev/null | grep -q "Debian"

echo "secure-boot hook: shim + Debian-signed GRUB installed into ${EFI_IMG} (${OLD_KB}KiB -> ${NEW_KB}KiB)"
