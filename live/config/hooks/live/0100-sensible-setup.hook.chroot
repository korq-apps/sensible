#!/bin/sh
set -e

# Make scripts in /usr/local/bin executable
chmod +x /usr/local/bin/sensible-install /usr/local/bin/lazydeb 2>/dev/null || true

# Enable NetworkManager
systemctl enable NetworkManager.service 2>/dev/null || true

# Set root password to empty or allow passwordless root console
passwd -d root 2>/dev/null || true
