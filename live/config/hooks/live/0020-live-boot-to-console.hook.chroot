#!/bin/sh
# Keep the default live boot on a text console.
#
# The image carries a full desktop (offline install copies this root to the
# target), so the display manager would otherwise start and take tty1 -- where
# the console installer autostarts. The boot menu's "Try Sensible" entry
# appends systemd.unit=graphical.target and gets the live desktop instead;
# the default "Install Sensible" entry keeps this console target, which the
# CI serial smoke test depends on.
#
# Set as the live image's default target rather than masking the display
# manager, so the installer restores it on the target with one command
# (systemctl set-default graphical.target) instead of unpicking a mask.
set -e

systemctl set-default multi-user.target
