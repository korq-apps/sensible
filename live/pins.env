# Pinned third-party artifacts baked into the offline image (PLAN Phase 6).
# Fetched and checksum-verified at ISO build time by scripts/fetch-pins.sh, so
# a rotted pin fails our build instead of a user's install. To bump a pin,
# update the value AND its SHA256 here, and refresh the "verified" date.
#
# Verified: 2026-09-01

# oh-my-bash: install target is /usr/share/oh-my-bash (no upstream tags exist,
# so the pin is a master commit + the tarball's SHA256).
OH_MY_BASH_COMMIT=0bd2d2c79e2ffb94dc25b4f039c0e7edbf1ae48e
OH_MY_BASH_TARBALL_SHA256=cf8d33ba2de0595c43913d13d6acac403f5633c60a446c5fbed6619e768126b2

# JetBrainsMono Nerd Font (Debian packages no Nerd Fonts). Only the standard
# spacing Regular/Italic/Bold/BoldItalic faces are baked, to keep the ISO small.
NERD_FONTS_TAG=v3.5.1
NERD_FONTS_JETBRAINS_MONO_ZIP_SHA256=fab782a66f7d3019da64f6572db9fc5d3a4bcb19f9fa13e2d8a62e3693d6396e

# LazyVim starter has no releases. Pin the main-branch archive by commit and
# checksum so the default editor configuration is reproducible.
LAZYVIM_STARTER_COMMIT=803bc181d7c0d6d5eeba9274d9be49b287294d99
LAZYVIM_STARTER_TARBALL_SHA256=b580d0bdb1654342dcf9f24fa1d4584bb91046a06dc1b6c866cbd06719b9dc7a

# LocalSend: official amd64 .deb, Apache-2.0; verified 2026-09-05 against
# the release asset's GitHub SHA256 digest and the downloaded bytes.
# The Debian control version includes the upstream build number.
LOCALSEND_VERSION=1.18.2
LOCALSEND_DEB_VERSION=1.18.2+64
LOCALSEND_DEB_SHA256=cc42a4f3eacdcb25ec31f0016b1272acb003145ab30484db8965450e20c72cd2
LOCALSEND_LICENSE_SHA256=38514afa30358fc21ef37551f3119b27d820427ece3c6f0ae014c7e47338c087
